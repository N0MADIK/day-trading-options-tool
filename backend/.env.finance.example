# ============================================================================
# Personal Finance API Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values

# Demo Mode - Set to 'true' to use mock data instead of real APIs
FINANCE_DEMO_MODE=true

# SnapTrade API
SNAPTRADE_CLIENT_ID="YourClientID"
SNAPTRADE_CONSUMER_KEY="YourConsumerKey"

# Aggregator API (Plaid) [DEPRECATED]
# Sign up at https://dashboard.plaid.com to get credentials
PLAID_CLIENT_ID="PLAID_CLIENT_ID"
PLAID_SECRET="PLAID_SECRET"
PLAID_ENV="sandbox"

# Robinhood Crypto API (Official)
# Get credentials from Robinhood's developer portal
ROBINHOOD_API_KEY=placeholder_api_key
ROBINHOOD_PRIVATE_KEY=your_ed25519_private_key_here
ROBINHOOD_API_URL=https://trading.robinhood.com

# Encryption Key for Auth Tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret and consistent across restarts
FINANCE_ENCRYPTION_KEY=your_32_byte_base64_encoded_key_here

# ============================================================================
# Existing Configuration (from your current .env)
# ============================================================================
# Add your existing environment variables below
